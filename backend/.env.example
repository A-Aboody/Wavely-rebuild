# Application
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# Database
# Matches docker-compose defaults. Port 5433 avoids clashing with a system Postgres on 5432.
DATABASE_URL="postgresql://wavely_user:wavely_dev_password@localhost:5433/wavely?schema=public"

# JWT - `npm run setup` generates these automatically. To rotate by hand:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate-me
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=generate-me
JWT_REFRESH_EXPIRATION=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Configuration (Choose one)
# Option 1: Gmail (for development) - Requires App Password: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_FROM=Wavely <noreply@wavely.com>

# Option 2: SendGrid (recommended for production) - Sign up: https://sendgrid.com
# SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# Option 3: AWS SES (recommended for production) - Requires AWS account
# AWS_SES_REGION=us-east-1
# AWS_SES_ACCESS_KEY=your_aws_ses_access_key
# AWS_SES_SECRET_KEY=your_aws_ses_secret_key

# AWS S3 (for file uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=wavely-media
AWS_CLOUDFRONT_URL=https://your-cloudfront-url.cloudfront.net

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/quicktime

# Account Security
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_TIME=900000
PASSWORD_RESET_EXPIRES=3600000
EMAIL_VERIFICATION_EXPIRES=86400000

# Google OAuth (Get credentials: https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Session Secret (Generate using same method as JWT secrets)
SESSION_SECRET=generate-me
