# Build from the repo root: docker build -f backend/Dockerfile.prod -t wavely-backend .
FROM node:22-alpine AS builder

RUN apk add --no-cache openssl
WORKDIR /app

COPY shared/ ./shared/
COPY backend/package*.json ./backend/
COPY backend/prisma ./backend/prisma/

WORKDIR /app/backend
RUN npm ci
RUN npx prisma generate

COPY backend/ ./
RUN npm run build

FROM node:22-alpine

RUN apk add --no-cache openssl
WORKDIR /app

COPY shared/ ./shared/
COPY backend/package*.json ./backend/
COPY backend/prisma ./backend/prisma/

WORKDIR /app/backend
# npm installs the prisma CLI as an optional peer of @prisma/client; it is build-time only.
# Clean cache in the same layer, or it ships inside the image.
RUN npm ci --omit=dev --no-audit --no-fund \
    && npm cache clean --force \
    && rm -rf node_modules/prisma node_modules/.bin/prisma \
        node_modules/@prisma/engines node_modules/@prisma/fetch-engine \
        node_modules/@prisma/get-platform

# Take the generated client from the builder; the Prisma CLI and its engines stay out of runtime
COPY --from=builder /app/backend/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/backend/dist ./dist

EXPOSE 3001
CMD ["npm", "run", "start:prod"]
