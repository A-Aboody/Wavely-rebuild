# Docker Compose Environment Variables (Production)

# PostgreSQL
POSTGRES_USER=wavely_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=wavely

# Redis
REDIS_PASSWORD=your_redis_password_here

# Ports
BACKEND_PORT=3001
FRONTEND_PORT=80

# Frontend Build Args
VITE_API_URL=http://your-domain.com/api
