# Optional overrides for docker-compose.yml. Every value below is the built-in default,
# so this file is only needed if you want to change one.
# Application config lives in backend/.env and frontend/.env (see README.md).

POSTGRES_USER=wavely_user
POSTGRES_PASSWORD=wavely_dev_password
POSTGRES_DB=wavely

# Host ports. 5433 avoids clashing with a system Postgres on 5432.
POSTGRES_PORT=5433
REDIS_PORT=6379
